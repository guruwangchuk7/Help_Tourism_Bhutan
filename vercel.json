{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "dist/index.js"
    }
  },
  "rewrites": [
    { "source": "/_/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
